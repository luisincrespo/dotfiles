#!/usr/bin/env bash
#
# Audit what is ALREADY committed — the half the hooks can't reach.
#
# pre-commit and commit-msg stop a leak going in. Neither helps with what is
# already there: content added and later deleted still lives in history, a
# `git commit --no-verify` bypasses both, and everything committed before a term
# reached the denylist was never checked against that term at all. That last one
# is the common case — the denylist grows when you change jobs or learn a
# codename, and it is retroactively wrong about every commit before it.
#
# Run it after adding denylist terms, before making a repo public, and when
# changing employers.
#
#   .githooks/leak-audit           every commit message and every blob, all refs
#   .githooks/leak-audit --tree    only the current working tree (fast)
#
# Exits 1 if anything is found, so it can gate a release or run in CI.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
source "${REPO_ROOT}/.githooks/leak-checks.sh"
cd "$REPO_ROOT" || exit 2

FOUND=0
MODE="${1:-history}"
ALLOW="${REPO_ROOT}/.githooks/leak-audit-allow.txt"
BINARY='\.(png|jpe?g|gif|webp|ico|pdf|zip|gz|tgz|woff2?|ttf|otf|mp4|mov)$'

# The hook files carry every credential shape as their own source, so scanning
# them matches on all of them. Same exclusion the hooks apply to themselves.
is_hook_path() { [[ "$1" == .githooks/* ]]; }

phase() { printf '\n\033[1m%s\033[0m\n' "$*"; }

# Drop lines already reviewed and accepted, before the checks see them. Findings
# that recur every run get ignored, which is the failure mode an audit can least
# afford — so accepted ones are recorded rather than re-reported.
ALLOW_PATS="$(grep -vE '^\s*(#|$)' "$ALLOW" 2>/dev/null || true)"
apply_allowlist() {
  if [[ -n "$ALLOW_PATS" ]]; then
    grep -vFf <(printf '%s\n' "$ALLOW_PATS") || true
  else
    cat
  fi
}

if [[ "$MODE" == "--tree" ]]; then
  phase "Working tree"
  text=""
  while IFS= read -r path; do
    is_hook_path "$path" && continue
    [[ "$path" =~ $BINARY ]] && continue
    text+="$(sed "s|^|${path}: |" "$path")"$'\n'
  done < <(git ls-files)
  scan_common "$(printf '%s' "$text" | normalize_ssh_remotes | apply_allowlist)"
  n_files=$(git ls-files | grep -vc '^\.githooks/' || true)
  printf '  scanned %s tracked files\n' "$n_files"
else
  # 1. Every commit message on every ref.
  n_commits=$(git rev-list --all --count)
  phase "Commit messages — ${n_commits} commits, all refs"
  msgs=""
  while IFS= read -r sha; do
    msgs+="$(git log -1 --format='%B' "$sha" | sed "s|^|${sha:0:9}: |")"$'\n'
  done < <(git rev-list --all)
  scan_common "$(printf '%s' "$msgs" | normalize_ssh_remotes | apply_allowlist)"

  # 2. Every blob ever committed — not just the current tree, so content that was
  #    added and later removed is still caught. Deduped by object id.
  phase "File content — every blob ever committed"
  blobs=""
  n_blobs=0
  while read -r sha path; do
    [[ -z "${path:-}" ]] && continue
    is_hook_path "$path" && continue
    [[ "$path" =~ $BINARY ]] && continue
    content="$(git cat-file blob "$sha" 2>/dev/null)" || continue
    [[ -z "$content" ]] && continue
    blobs+="$(printf '%s' "$content" | sed "s|^|${path}@${sha:0:7}: |")"$'\n'
    n_blobs=$((n_blobs + 1))
  done < <(git rev-list --objects --all | awk 'NF==2 {print $1, $2}' | sort -u -k1,1)
  scan_common "$(printf '%s' "$blobs" | normalize_ssh_remotes | apply_allowlist)"
  printf '  scanned %s blobs\n' "$n_blobs"
fi

if (( FOUND )); then
  cat <<MSG

  ────────────────────────────────────────────────────────────────
  Already committed. A hook cannot fix this — the content is in
  history, and on every clone that has fetched it.

  Rewriting history (filter-repo, or a fresh squashed root) and a
  force-push is the only real removal, and only helps if nobody
  else has pulled. For a remote that has been public, treat the
  value as disclosed and rotate it instead.
  ────────────────────────────────────────────────────────────────

MSG
  exit 1
fi

n_allow=$(printf '%s\n' "$ALLOW_PATS" | grep -c . || true)
printf '\n  \033[1;32mClean.\033[0m Nothing that should not travel'
[[ "$n_allow" -gt 0 ]] && printf ' (%s reviewed exception(s) applied)' "$n_allow"
printf '.\n\n'
exit 0
