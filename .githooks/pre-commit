#!/usr/bin/env bash
#
# Leak guard for a portable dotfiles repo — the lines a commit ADDS.
# Its sibling `commit-msg` runs the same checks over the message.
#
# Shared patterns live in leak-checks.sh. What's here is the part that only
# applies to a diff: reading staged lines, and the voice-corpus person check,
# which is scoped to specific paths and so has no meaning for a message.
#
# Company names live in ~/.agents/local/commit-denylist.txt, NOT in this repo — a
# denylist naming an employer would itself be the leak it's meant to prevent.
#
# Override a false positive with:  git commit --no-verify

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
source "${REPO_ROOT}/.githooks/leak-checks.sh"

ROSTER="${REPO_ROOT}/.githooks/placeholder-roster.txt"
VOICE_REFS="skills/voice/refs/"
FOUND=0

# The hook files carry these patterns as their own source, so scanning them
# self-matches on every credential shape they know about. Excluded wholesale;
# the roster beside them is a list of invented names and needs no scanning.
HOOKS='.githooks/'

# Added lines only, each prefixed with its file.
added() {
  git diff --cached --unified=0 --no-color -- . ":(exclude)${HOOKS}" \
    | awk '
        /^\+\+\+ b\// { file = substr($0, 7); next }
        /^\+[^+]/        { print file ": " substr($0, 2) }
      '
}

# The identity this commit is about to carry. Checked first and regardless of what
# the diff holds, because it is the one thing a later scan can never fix: rewriting
# it changes every sha from here on. This is how three past employers' addresses
# reached this history — each commit looked fine, and nothing was looking at who
# was making it.
scan_identity "author: $(git var GIT_AUTHOR_IDENT | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')"

ADDED="$(added | normalize_ssh_remotes)"
if [[ -z "$ADDED" ]]; then
  (( FOUND )) && { leak_blocked "identity"; exit 1; }
  exit 0
fi

scan_common "$ADDED"

# --- Unknown people in the voice corpus -------------------------------------
# The voice examples are anonymized by contract, so every person in them is
# invented. Anything person-shaped that is not on the roster is therefore a real
# name that slipped in — caught the first time, without predicting it.
VERBS='asked|approved|flagged|replied|said|wanted|proposed|corrected|noticed|pointed|cut|trimmed|rewrote|edited'
# Capitalized words that open a sentence and are not people. Without these, "Also cut
# the preamble" reads as a person named Also. A real name will never be on this list,
# so it narrows nothing that matters — extend it as new ones turn up.
NOT_NAMES='Also|And|But|For|Not|Now|Here|There|Then|This|That|These|Those|They|Their|We|You|She|Both|Each|Every|Everyone|Someone|Nobody|One|First|Second|Later|Again|Still|Even|Only|Just|What|When|Where|Which|Who|Why|How|Most|Some|Any|All|Before|After|Once|Instead|Rather|Better|Worse|Same|Note|Keep|Drop|Same'
if [[ -r "$ROSTER" ]]; then
  KNOWN="$(grep -vE '^[[:space:]]*(#|$)' "$ROSTER" | sed 's/[[:space:]]*$//' | tr 'A-Z' 'a-z')"
  known() { printf '%s\n' "$KNOWN" | grep -qxF "$(printf '%s' "$1" | tr 'A-Z' 'a-z')"; }

  VOICE_ADDED="$(printf '%s\n' "$ADDED" | grep -F "$VOICE_REFS" || true)"
  if [[ -n "$VOICE_ADDED" ]]; then
    unknown=""
    # 1. @mentions: @handle, @first.last, @Firstname Lastname
    # 2. Narrative: "Firstname asked", "Firstname Lastname approved", ...
    # The placeholder email domains drop out: `@example.com` is a domain, not a handle,
    # and the email check already declares it safe. Deliberately narrow — a real bare
    # `@domain.tld` has no local part for the email check to match, so staying
    # person-shaped here is the only pass it gets.
    cands="$(printf '%s\n' "$VOICE_ADDED" \
      | grep -oE "@[A-Za-z][A-Za-z0-9._-]*( [A-Z][a-z]+)?|[A-Z][a-z]{2,}( [A-Z][a-z]+)? ($VERBS)" \
      | sed -E "s/^@//; s/ ($VERBS)\$//" \
      | grep -ivE '^example\.(com|org|net)$' \
      | grep -vE "^(${NOT_NAMES})( |$)" \
      | sort -u || true)"
    while IFS= read -r c; do
      [[ -z "$c" ]] && continue
      known "$c" && continue
      known "${c%% *}" && continue   # known first name + new surname is fine
      unknown="${unknown}    ${c}"$'\n'
    done <<< "$cands"
    if [[ -n "$unknown" ]]; then
      printf '\n  \033[1;31m%s\033[0m\n' "Unrecognized person in the voice corpus"
      printf '%s' "$unknown"
      printf '\n  %s\n  %s\n' \
        "Every person in claude/skills/voice/refs/ must be invented." \
        "Replace with a placeholder, or add it to .githooks/placeholder-roster.txt if it is one."
      FOUND=1
    fi
  fi
fi

if (( FOUND )); then
  leak_blocked "lines"
  exit 1
fi
exit 0
